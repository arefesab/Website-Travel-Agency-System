@{
    ViewData["Title"] = agancywebProject.Helpers.Lang.T(Context, "صفحه اصلی", "Home");
    var lastMinuteHotels = ViewBag.LastMinuteHotels as IEnumerable<agancywebProject.Models.DB.Hotel>;
    var lastMinuteFlights = ViewBag.LastMinuteFlights as IEnumerable<agancywebProject.Models.DB.Flight>;
}

<section class="hero">
    <img class="hero-photo" src="~/folder/css/airplane-hero-3840.jpg" alt="" fetchpriority="high" />
    <div class="container hero-content">
        <h1>@Lang.T(Context, "برای سفرهایی فراتر از معمول", "For journeys beyond the ordinary")</h1>
        <p>@Lang.T(Context, "بهترین قیمت بلیط هواپیما و رزرو هتل، با پشتیبانی ۲۴ ساعته و امکان کنسلی آسان", "Best prices on flights and hotels, with 24/7 support and easy cancellation")</p>
    </div>
</section>

<section class="container search-section">
    <div class="search-widget">
        <div class="search-tabs" role="tablist">
            <button type="button" class="search-tab is-active" data-target="#panel-flight" role="tab">@Lang.T(Context, "جستجوی پرواز", "Search Flights")</button>
            <button type="button" class="search-tab" data-target="#panel-hotel" role="tab">@Lang.T(Context, "جستجوی هتل", "Search Hotels")</button>
        </div>

        <div id="panel-flight" class="search-panel is-active">
            <form asp-controller="Flightsshow" asp-action="Index" method="get">
                <label class="switch-row mb-3" for="home-fs-roundtrip">
                    <span class="switch">
                        <input type="checkbox" id="home-fs-roundtrip" name="tripType" value="roundtrip" />
                        <span class="slider"></span>
                    </span>
                    <span class="switch-label-text">@Lang.T(Context, "پرواز رفت و برگشت می‌خواهم", "I want a round-trip flight")</span>
                </label>
                <div class="row g-3">
                    <div class="col-md-6 col-lg-3">
                        <label class="form-label" for="flight-origin">@Lang.T(Context, "مبدا پرواز", "Origin")</label>
                        <select id="flight-origin" name="origin" class="form-select">
                            <option value="">@Lang.T(Context, "همه مبدا‌ها", "All origins")</option>
                            @foreach (var originCity in (ViewBag.FlightOrigins as List<string>) ?? new List<string>())
                            {
                                <option value="@originCity">@Lang.Fin(Context, originCity)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <label class="form-label" for="flight-destination">@Lang.T(Context, "مقصد پرواز", "Destination")</label>
                        <select id="flight-destination" name="destination" class="form-select">
                            <option value="">@Lang.T(Context, "همه مقصدها", "All destinations")</option>
                            @foreach (var destCity in (ViewBag.FlightDestinations as List<string>) ?? new List<string>())
                            {
                                <option value="@destCity">@Lang.Fin(Context, destCity)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 col-lg">
                        <label class="form-label" for="flight-date">@Lang.T(Context, "تاریخ رفت", "Departure date") <span class="text-danger">*</span></label>
                        <input id="flight-date" type="date" name="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-4 col-lg" id="home-fs-returndate-wrap" style="display:none;">
                        <label class="form-label" for="flight-return">@Lang.T(Context, "تاریخ برگشت", "Return date") <span class="text-danger">*</span></label>
                        <input id="flight-return" type="date" name="returnDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-4 col-lg-2">
                        <label class="form-label" for="flight-passengers">@Lang.T(Context, "تعداد مسافر", "Passengers")</label>
                        <input id="flight-passengers" type="number" min="1" value="1" name="passengers" class="form-control" />
                    </div>
                </div>
                <p class="search-hint">@Lang.T(Context, "برای جستجو وارد کردن تاریخ رفت الزامی است.", "A departure date is required to search.")</p>
                <button type="submit" class="btn btn-brand search-submit">@Lang.T(Context, "جستجوی پرواز", "Search Flights")</button>
            </form>
        </div>

        <div id="panel-hotel" class="search-panel">
            <form asp-controller="Hotelsshow" asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-lg-4">
                        <label class="form-label" for="hotel-city">@Lang.T(Context, "مقصد", "Destination")</label>
                        <select id="hotel-city" name="city" class="form-select">
                            <option value="">@Lang.T(Context, "همه شهرها", "All cities")</option>
                            <option value="تهران">@Lang.T(Context, "تهران", "Tehran")</option>
                            <option value="اهواز">@Lang.T(Context, "اهواز", "Ahvaz")</option>
                            <option value="اصفهان">@Lang.T(Context, "اصفهان", "Isfahan")</option>
                            <option value="بندرعباس">@Lang.T(Context, "بندرعباس", "Bandar Abbas")</option>
                            <option value="مشهد">@Lang.T(Context, "مشهد", "Mashhad")</option>
                            <option value="شیراز">@Lang.T(Context, "شیراز", "Shiraz")</option>
                            <option value="کرمان">@Lang.T(Context, "کرمان", "Kerman")</option>
                            <option value="عسلویه">@Lang.T(Context, "عسلویه", "Asaluyeh")</option>
                            <option value="کیش">@Lang.T(Context, "کیش", "Kish")</option>
                            <option value="تبریز">@Lang.T(Context, "تبریز", "Tabriz")</option>
                            <option value="قشم">@Lang.T(Context, "قشم", "Qeshm")</option>
                        </select>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <label class="form-label" for="hotel-checkin">@Lang.T(Context, "تاریخ ورود", "Check-in") <span class="text-danger">*</span></label>
                        <input id="hotel-checkin" type="date" name="checkin" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <label class="form-label" for="hotel-checkout">@Lang.T(Context, "تاریخ خروج", "Check-out")</label>
                        <input id="hotel-checkout" type="date" name="checkout" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <p class="search-hint">@Lang.T(Context, "برای جستجو وارد کردن تاریخ ورود الزامی است.", "A check-in date is required to search.")</p>
                <button type="submit" class="btn btn-brand search-submit">@Lang.T(Context, "جستجوی هتل", "Search Hotels")</button>
            </form>
        </div>
    </div>
</section>

<section class="container board-section">
    <div class="section-heading section-heading-row">
        <div>
            <h2>@Lang.T(Context, "پرواز‌های لحظه‌آخری", "Last-Minute Flights")</h2>
            <p>@Lang.T(Context, "بلیط پروازهای نزدیک، با بهترین قیمت موجود", "Tickets for upcoming flights, at the best available price")</p>
        </div>
        <a class="link-more" asp-controller="Flightsshow" asp-action="Index">@Lang.T(Context, "همه پروازها", "All flights")</a>
    </div>
    @* DYN:flights *@
    @if (lastMinuteFlights != null && lastMinuteFlights.Any())
    {
        <table class="board" data-board>
            <thead>
                <tr>
                    <th>@Lang.T(Context, "ساعت", "Time")</th>
                    <th>@Lang.T(Context, "مسیر", "Route")</th>
                    <th>@Lang.T(Context, "تاریخ رفت", "Departure")</th>
                    <th>@Lang.T(Context, "کلاس", "Class")</th>
                    <th>@Lang.T(Context, "زمان باقی‌مانده", "Time left")</th>
                    <th>@Lang.T(Context, "قیمت هر نفر", "Price per person")</th>
                    <th><span class="visually-hidden">@Lang.T(Context, "رزرو", "Book")</span></th>
                </tr>
            </thead>
            <tbody>
                @{ var rowIndex = 0; }
                @foreach (var flight in lastMinuteFlights)
                {
                    var flightDaysLeft = (flight.startdate.Date - DateTime.Today).Days;
                    <tr style="--i:@(rowIndex++)">
                        <td class="b-time" dir="ltr">
                            @foreach (var ch in flight.entrytime.ToString("HH:mm"))
                            {
                                <span class="@(ch == ':' ? "flap-sep" : "flap")">@ch</span>
                            }
                        </td>
                        <td class="b-route">
                            <span>@Lang.Fin(Context, flight.Origin)</span>
                            <svg class="route-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h17M14 6l6 6-6 6"/></svg>
                            <span>@Lang.Fin(Context, flight.distination)</span>
                        </td>
                        <td class="b-date" dir="ltr">@flight.startdate.ToString("yyyy-MM-dd")</td>
                        <td class="b-class">@Lang.FlightClass(Context, flight.flightClass)</td>
                        <td class="b-left"><span class="@(flightDaysLeft <= 0 ? "board-chip board-chip-hot" : "board-chip")">@(flightDaysLeft <= 0 ? Lang.T(Context, "پرواز امروز", "Flight today") : Lang.T(Context, $"{flightDaysLeft} روز تا پرواز", $"{flightDaysLeft} days to flight"))</span></td>
                        <td class="b-price"><strong>@flight.price.ToString("N0")</strong> <small>@Lang.T(Context, "تومان", "Toman")</small></td>
                        <td class="b-act"><a asp-controller="FlightBooking" asp-action="Reserve" asp-route-id="@flight.Flight_Id" class="btn btn-brand btn-sm">@Lang.T(Context, "رزرو", "Book")</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <p>@Lang.T(Context, "در حال حاضر آفر لحظه‌آخری پروازی ثبت نشده است.", "No last-minute flight deals are available right now.")</p>
        </div>
    }
    @* /DYN *@
</section>

<section class="container">
    <div class="section-heading">
        <h2>@Lang.T(Context, "هتل‌های پرتخفیف، با قیمت ویژه", "Hot Hotel Deals")</h2>
        <p>@Lang.T(Context, "اتاق‌های خالی با تخفیف‌هایی که زود تمام می‌شوند؛ پیش از پر شدن ظرفیت رزرو کنید", "Vacant rooms at prices that won't last — book before they're gone")</p>
    </div>
    @* DYN:hotels *@
    @if (lastMinuteHotels != null && lastMinuteHotels.Any())
    {
        <div class="hot-grid">
            @foreach (var hotel in lastMinuteHotels)
            {
                var hotelPhotos = (hotel.photoUrls ?? string.Empty)
                .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(p => Url.Content(p))
                .ToArray();
                var hotelMainPhoto = hotelPhotos.Length > 0 ? hotelPhotos[0] : null;
                var hotelDealEnd = hotel.finishdate;
                (ViewBag.HotelDealEnds as Dictionary<int, DateTime>)?.TryGetValue(hotel.Hotel_Id, out hotelDealEnd);
                var hotelDaysLeft = (hotelDealEnd.Date - DateTime.Today).Days;
                int pct = 0;
                (ViewBag.HotelDiscounts as Dictionary<int, int>)?.TryGetValue(hotel.Hotel_Id, out pct);
                <a asp-controller="Hotelsshow" asp-action="Details" asp-route-id="@hotel.Hotel_Id" class="hot-card">
                    <div class="hot-media">
                        @if (hotelMainPhoto != null)
                        {
                            <img class="hotel-photo" src="@hotelMainPhoto" alt="@Lang.Fin(Context, hotel.name)" loading="lazy" data-nophoto-text="@Lang.T(Context, "بدون عکس", "No photo")" />
                        }
                        else
                        {
                            <partial name="_NoPhoto" />
                        }
                        @if (pct > 0) { <span class="hot-off">@pct%<small>@Lang.T(Context, "تخفیف", "OFF")</small></span> }
                        <span class="hot-time@(hotelDaysLeft <= 1 ? " is-urgent" : "")">@(hotelDaysLeft <= 0 ? Lang.T(Context, "آخرین فرصت امروز", "Last chance today") : hotelDaysLeft == 1 ? Lang.T(Context, "فقط تا فردا", "Until tomorrow") : Lang.T(Context, $"{hotelDaysLeft} روز تا پایان", $"{hotelDaysLeft} days left"))</span>
                    </div>
                    <div class="hot-body">
                        <div class="hot-head">
                            <h3 class="hot-title">@Lang.Fin(Context, hotel.name)</h3>
                            @if (!string.IsNullOrWhiteSpace(hotel.roomName)) { <p class="hot-room">@Lang.T(Context, "اتاق", "Room"): @Lang.Fin(Context, hotel.roomName)</p> }
                            <p class="hot-meta"><span>@Lang.Fin(Context, hotel.city)</span>@if (hotel.star > 0)
                                {
                                    <span class="hot-stars" aria-label="@hotel.star @Lang.T(Context, "ستاره", "stars")">@(new string('★', Math.Min(hotel.star, 5)))</span>
                                }</p>
                        </div>
                        <div class="hot-foot">
                            <div class="hot-price">
                                @if (pct > 0) { <s>@hotel.price.ToString("N0")</s> }
                                <strong>@HotelPricing.Apply(hotel.price, pct).ToString("N0")</strong>
                                <small>@Lang.T(Context, "تومان / شب", "Toman / night")</small>
                            </div>
                            <span class="hot-cta">@Lang.T(Context, "مشاهده و رزرو", "View & book")<i aria-hidden="true">&larr;</i></span>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>@Lang.T(Context, "در حال حاضر آفر لحظه‌آخری هتلی ثبت نشده است.", "No last-minute hotel deals are available right now.")</p>
        </div>
    }
    @* /DYN *@
</section>

