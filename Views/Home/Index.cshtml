@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            // Flight panel: round-trip switch
            var roundtripSwitch = document.getElementById('home-fs-roundtrip');
            var returnWrap = document.getElementById('home-fs-returndate-wrap');
            var returnInput = document.getElementById('flight-return');
            var dateInput = document.getElementById('flight-date');

            function syncReturnVisibility() {
                var isRoundTrip = roundtripSwitch.checked;
                returnWrap.style.display = isRoundTrip ? '' : 'none';
                if (returnInput) {
                    returnInput.required = isRoundTrip;
                    if (!isRoundTrip) {
                        returnInput.value = '';
                    }
                }
            }
            function syncFlightMinReturn() {
                if (dateInput && dateInput.value && returnInput) {
                    returnInput.min = dateInput.value;
                    if (returnInput.value && returnInput.value <= dateInput.value) {
                        returnInput.value = '';
                    }
                }
            }
            if (roundtripSwitch) {
                roundtripSwitch.addEventListener('change', syncReturnVisibility);
                syncReturnVisibility();
            }
            if (dateInput) {
                dateInput.addEventListener('change', syncFlightMinReturn);
            }

            // Hotel panel: check-out must be after check-in
            var checkinInput = document.getElementById('hotel-checkin');
            var checkoutInput = document.getElementById('hotel-checkout');
            function syncHotelMin() {
                if (checkinInput && checkinInput.value && checkoutInput) {
                    checkoutInput.min = checkinInput.value;
                    if (checkoutInput.value && checkoutInput.value <= checkinInput.value) {
                        checkoutInput.value = '';
                    }
                }
            }
            if (checkinInput) {
                checkinInput.addEventListener('change', syncHotelMin);
            }
        })();
    </script>
}
