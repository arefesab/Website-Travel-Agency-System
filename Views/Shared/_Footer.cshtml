<footer class="site-footer" id="site-footer">
    <div class="container">
        <div class="row gy-4">
            <div class="col-md-4">
                <h5><span class="brand-mark" style="width:28px;height:28px;font-size:.85rem;">✈</span> @Lang.T(Context, "آژانس هواپیمایی افق", "Ofogh Air Agency")</h5>
                <p class="text-muted-light mt-2">@Lang.T(Context, "بلیط هواپیما و رزرو هتل، داخلی و خارجی، با بهترین قیمت و پشتیبانی ۲۴ ساعته.", "Domestic & international flights and hotels, best prices, 24/7 support.")</p>
                <div class="social-row">
                    <a class="social-btn" href="#" aria-label="@Lang.T(Context, "اینستاگرام", "Instagram")" title="@Lang.T(Context, "اینستاگرام", "Instagram")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
                    </a>
                    <a class="social-btn" href="#" aria-label="@Lang.T(Context, "تلگرام", "Telegram")" title="@Lang.T(Context, "تلگرام", "Telegram")">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.5 3.5 2.7 10.9c-.8.32-.79 1.44 0 1.74l4.57 1.65 1.77 5.4c.24.75 1.2.9 1.7.29l2.4-2.9 4.55 3.34c.68.5 1.65.13 1.83-.7L23.9 4.6c.2-.9-.7-1.6-1.4-1.1Z"/></svg>
                    </a>
                    <a class="social-btn" href="#" aria-label="@Lang.T(Context, "واتساپ", "WhatsApp")" title="@Lang.T(Context, "واتساپ", "WhatsApp")">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.02 2C6.5 2 2 6.48 2 12c0 1.85.5 3.58 1.38 5.07L2 22l5.1-1.34A9.96 9.96 0 0 0 12.02 22C17.52 22 22 17.52 22 12S17.52 2 12.02 2Z"/></svg>
                    </a>
                </div>
            </div>
            <div class="col-md-4">
                <h6>@Lang.T(Context, "تماس با ما", "Contact Us")</h6>
                <p class="mb-1">@Lang.T(Context, "آدرس: تهران - خیابان ***", "Address: Tehran - *** St.")</p>
                <p class="mb-1">@Lang.T(Context, "تلفن دفتر فروش: ۰۲۱-۲۲۰*****", "Sales phone: 021-220*****")</p>
                <p class="mb-1">@Lang.T(Context, "پشتیبانی آنلاین: ۹ صبح تا ۱۲ شب", "Online support: 9 AM - 12 AM")</p>
                <p class="mb-0">@Lang.T(Context, "ایمیل", "Email"): info@example.com</p>
            </div>
            <div class="col-md-4">
                <h6>@Lang.T(Context, "دسترسی سریع", "Quick Links")</h6>
                <ul class="footer-links">
                    <li><a asp-controller="Home" asp-action="Index">@Lang.T(Context, "صفحه اصلی", "Home")</a></li>
                    <li><a asp-controller="Flightsshow" asp-action="Index">@Lang.T(Context, "بلیط هواپیما", "Flights")</a></li>
                    <li><a asp-controller="Hotelsshow" asp-action="Index">@Lang.T(Context, "رزرو هتل", "Hotels")</a></li>
                    <li><a href="#faq-section">@Lang.T(Context, "سوالات متداول", "FAQ")</a></li>
                    <li><a asp-controller="Admin" asp-action="Login">@Lang.T(Context, "ورود ادمین", "Admin Login")</a></li>
                </ul>
            </div>
        </div>
        <hr class="footer-divider" />
        <p class="text-center small text-muted-light mb-0">© @DateTime.Now.Year @Lang.T(Context, "آژانس هواپیمایی افق. تمامی حقوق محفوظ است.", "Ofogh Air Agency. All rights reserved.")</p>
    </div>
</footer>
