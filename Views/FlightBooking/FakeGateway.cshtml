@model agancywebProject.Models.DB.FlightBooking
@{
    var flight = Model.Flight!;
    ViewData["Title"] = Lang.T(Context, "درگاه پرداخت (آزمایشی)", "Payment Gateway (Test)");
    Layout = null;
    var remainingSeconds = Model.LockSecondsRemaining;
}
<!DOCTYPE html>
<html lang="@(Lang.IsTranslated(Context) ? "en" : "fa")" dir="@(Lang.IsTranslated(Context) ? "ltr" : "rtl")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Lang.T(Context, "درگاه پرداخت آزمایشی", "Payment Gateway (Test)")</title>
    @if (Lang.IsTranslated(Context))
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (Lang.IsTranslated(Context))
    {
        <link rel="stylesheet" href="~/css/site-ltr.css" asp-append-version="true" />
    }
    <style>
        .hold-timer { display:flex; align-items:center; justify-content:center; gap:.5rem; margin:0 0 1rem; padding:.55rem .75rem; border-radius:.6rem; background:rgba(0,0,0,.05); font-size:.95rem; }
        .hold-timer strong { font-size:1.25rem; font-variant-numeric:tabular-nums; letter-spacing:.04em; }
        .hold-timer.is-warning { background:rgba(192,57,43,.12); color:#c0392b; }
        .hold-expired { margin:0 0 1rem; padding:.75rem; border-radius:.6rem; background:rgba(192,57,43,.12); color:#c0392b; text-align:center; }
        .hold-timer[hidden], .hold-expired[hidden] { display:none; }
        .hold-expired a { display:block; margin-top:.4rem; font-weight:600; }
    </style>
</head>
<body>
    <div class="page-container" style="max-width:480px;">
        <div class="table-wrap fake-gateway-card">
            <div class="fake-gateway-badge">@Lang.T(Context, "درگاه پرداخت آزمایشی", "Payment Gateway (Test)")</div>
            <h2 class="mt-2 mb-1">@Lang.T(Context, "تکمیل پرداخت", "Complete payment")</h2>
            <p class="form-text-hint mb-3">
                @Lang.T(Context, "این یک درگاه شبیه‌سازی‌شده برای تست سایت است (به بانک واقعی وصل نیست). برای اتصال به درگاه بانکی واقعی، تنظیمات Payment در appsettings.json را کامل کنید.", "This is a simulated gateway for testing the site (not connected to a real bank). To connect a real payment gateway, complete the Payment settings in appsettings.json.")
            </p>

            <dl class="detail-list mb-3">
                <dt>@Lang.T(Context, "پرواز", "Flight")</dt>
                <dd>@Lang.Fin(Context, flight.Origin) — @Lang.Fin(Context, flight.distination)</dd>
                <dt>@Lang.T(Context, "تاریخ", "Date")</dt>
                <dd>@Lang.Num(Context, flight.startdate.ToString("yyyy-MM-dd"))</dd>
                <dt>@Lang.T(Context, "خریدار", "Buyer")</dt>
                <dd>@Model.FullName</dd>
                <dt>@Lang.T(Context, "تعداد صندلی", "Seats")</dt>
                <dd>@Model.SeatCount</dd>
                <dt>@Lang.T(Context, "مبلغ قابل پرداخت", "Amount due")</dt>
                <dd><strong class="booking-total">@Model.TotalPrice.ToString("N0") @Lang.T(Context, "تومان", "Toman")</strong></dd>
            </dl>

            <div id="hold-timer" class="hold-timer" role="timer">
                <span>@Lang.T(Context, "زمان باقی‌مانده برای پرداخت:", "Time left to pay:")</span>
                <strong id="hold-timer-text" class="notranslate" translate="no" dir="ltr">--:--</strong>
            </div>
            <div id="hold-expired" class="hold-expired" role="alert" hidden>
                @Lang.T(Context, "زمان پرداخت شما تمام شد و رزرو آزاد شد.", "Your payment time ran out and the booking was released.")
                <a asp-controller="FlightBooking" asp-action="Reserve" asp-route-id="@flight.Flight_Id">@Lang.T(Context, "رزرو دوباره", "Book again")</a>
            </div>

            <form asp-controller="FlightBooking" asp-action="FakeGatewayConfirm" id="gateway-form" method="post" class="d-grid gap-2">
                <input type="hidden" name="authority" value="@Model.Authority" />
                <button type="submit" id="pay-btn" name="approved" value="true" class="btn btn-brand w-100">@Lang.T(Context, "پرداخت موفق (شبیه‌سازی)", "Successful payment (simulated)")</button>
                <button type="submit" name="approved" value="false" class="btn btn-outline-secondary w-100">@Lang.T(Context, "انصراف از پرداخت", "Cancel payment")</button>
            </form>
        </div>
    </div>
    @if (Lang.IsTranslated(Context))
    {
        <partial name="_GoogleTranslate" />
    }
    <script>
        (function () {
            // Seconds left come from the server; the deadline is measured on this device's own clock,
            // so a wrong clock on the visitor's device cannot shift the timer.
            var remaining = @remainingSeconds;
            var deadline = Date.now() + remaining * 1000;
            var timerBox = document.getElementById('hold-timer');
            var timerText = document.getElementById('hold-timer-text');
            var expiredBox = document.getElementById('hold-expired');
            var payBtn = document.getElementById('pay-btn');
            var id = null;

            function pad(n) { return (n < 10 ? '0' : '') + n; }

            function tick() {
                var left = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
                if (left <= 0) {
                    if (id) clearInterval(id);
                    timerBox.hidden = true;
                    expiredBox.hidden = false;
                    if (payBtn) payBtn.disabled = true;
                    return;
                }
                timerText.textContent = pad(Math.floor(left / 60)) + ':' + pad(left % 60);
                timerBox.classList.toggle('is-warning', left <= 60);
            }

            tick();
            id = setInterval(tick, 1000);
        })();
    </script>
</body>
</html>
