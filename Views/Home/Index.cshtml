<section class="band">
    <div class="container">
        <div class="band-grid">
            <h2>@Lang.T(Context, "چرا آژانس افق؟", "Why Ofogh Agency?")</h2>
            <div class="band-point">
                <h3>@Lang.T(Context, "بهترین قیمت تضمینی", "Guaranteed Best Price")</h3>
                <p>@Lang.T(Context, "مقایسه لحظه‌ای قیمت پروازها و هتل‌ها از چند منبع، بدون هزینه پنهان.", "Real-time price comparison across multiple sources, no hidden fees.")</p>
            </div>
            <div class="band-point">
                <h3>@Lang.T(Context, "رزرو امن و مطمئن", "Safe & Reliable Booking")</h3>
                <p>@Lang.T(Context, "پرداخت امن و امکان کنسلی آسان تا قبل از تاریخ پرواز طبق قوانین ایرلاین.", "Secure payment and easy cancellation before departure, per airline policy.")</p>
            </div>
