@{
    bool isTranslated = Lang.IsTranslated(Context);
    // ---- CHOOSE THE SITE THEME HERE: "mix" | "light" | "vivid" | "glass" | "warm" | "lux" ----
    string theme = "mix";
    bool isLux = theme == "lux";
    bool keepToggle = theme == "mix"; // only "mix" has a working light/dark switch
    bool isDarkTheme = theme == "lux" || theme == "glass";
    string themeCss = isLux ? "~/css/site-lux.css" : "~/css/site-theme-" + theme + ".css";
    string themeColor = theme switch { "lux" => "#050507", "mix" => "#10252e", "glass" => "#070b1f", "vivid" => "#6d28d9", "warm" => "#f5eddd", _ => "#ffffff" };
}
<!DOCTYPE html>
<html lang="@(isTranslated ? "en" : "fa")" dir="@(isTranslated ? "ltr" : "rtl")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="@themeColor" />
    <title>@ViewData["Title"] - @Lang.T(Context, "آژانس هواپیمایی افق", "Ofogh Air Agency")</title>
    @if (isTranslated)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-v2.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-reveal.css" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content(themeCss)" asp-append-version="true" />
    @if (isTranslated && isLux)
    {
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&display=swap" />
    }
    @if (isTranslated)
    {
        <link rel="stylesheet" href="~/css/site-ltr.css" asp-append-version="true" />
    }
    <script>
        // Scroll-reveal animations: only when motion is allowed. Falls back to a fully visible page if the script never runs.
        (function () {
            try {
                var r = document.documentElement;
                if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
                if (!("IntersectionObserver" in window)) return;
                r.classList.add("rv-ready");
                setTimeout(function () { if (!window.__rvInit) r.classList.remove("rv-ready"); }, 4000);
            } catch (e) {}
        })();
    </script>
    <script>
        // Prevent a color flash on load when dark mode is active
        (function () {
            try {
                var t = localStorage.getItem("ofogh-theme");
                document.documentElement.classList.add("js");
                @if (keepToggle)
                {
                    <text>if (t === "dark") document.documentElement.setAttribute("data-theme", "dark");</text>
                }
                else
                {
                    <text>
                localStorage.removeItem("ofogh-theme");
                document.documentElement.setAttribute("data-theme", "@(isDarkTheme ? "dark" : "light")");
                    </text>
                }
                @if (isLux)
                {
                    <text>
                if (!sessionStorage.getItem("ofogh-intro")) {
                    document.documentElement.classList.add("lux-intro-on");
                    sessionStorage.setItem("ofogh-intro", "1");
                }
                    </text>
                }
            } catch (e) {}
        })();
    </script>
</head>
<body>
    @if (isLux)
    {
    <div class="lux-intro" aria-hidden="true">
        <div class="lux-curtain lux-curtain-top"></div>
        <div class="lux-curtain lux-curtain-bottom"></div>
        <div class="lux-intro-mark">
            <svg viewBox="0 0 32 32"><path d="M6 22a10 10 0 0 1 20 0"/><path d="M2 26h28"/><path d="M16 5v3M6.5 9.5l2 2M25.5 9.5l-2 2"/></svg>
            <span class="lux-intro-name notranslate" translate="no">OFOGH</span>
            <span class="lux-intro-line"></span>
        </div>
    </div>
    }
    <partial name="_Nav" />

    <main role="main">
        @RenderBody()
    </main>

    <partial name="_Footer" />

    <div class="float-actions">
        <a class="float-btn whatsapp-btn" href="https://wa.me/989130862556" target="_blank" rel="noopener" aria-label="@Lang.T(Context, "گفتگو در واتساپ", "Chat on WhatsApp")" title="@Lang.T(Context, "گفتگو در واتساپ", "Chat on WhatsApp")">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.02 2C6.5 2 2 6.48 2 12c0 1.85.5 3.58 1.38 5.07L2 22l5.1-1.34A9.96 9.96 0 0 0 12.02 22C17.52 22 22 17.52 22 12S17.52 2 12.02 2Zm0 18.15c-1.62 0-3.15-.44-4.46-1.2l-.32-.19-3.03.8.81-2.95-.21-.31A8.15 8.15 0 0 1 3.85 12c0-4.5 3.67-8.15 8.17-8.15S20.19 7.5 20.19 12s-3.67 8.15-8.17 8.15Zm4.5-6.13c-.25-.12-1.46-.72-1.68-.8-.23-.09-.39-.12-.56.12-.16.25-.63.8-.78.96-.14.16-.29.18-.53.06-1.43-.71-2.36-1.27-3.3-2.88-.25-.43.25-.4.71-1.33.08-.16.04-.3-.03-.42-.08-.12-.6-1.44-.82-1.97-.22-.52-.44-.45-.61-.46-.16 0-.34-.01-.53-.01-.18 0-.48.07-.73.34-.25.27-.96.94-.96 2.29 0 1.35.98 2.65 1.12 2.83.14.18 1.9 2.9 4.6 3.95 2.21.86 2.66.69 3.14.65.48-.05 1.55-.63 1.77-1.24.22-.6.22-1.12.15-1.24-.07-.11-.25-.18-.5-.3Z"/></svg>
        </a>
        <button type="button" class="float-btn back-to-top" aria-label="@Lang.T(Context, "بازگشت به بالا", "Back to top")" title="@Lang.T(Context, "بازگشت به بالا", "Back to top")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
        </button>
    </div>

    @if (isTranslated)
    {
        <partial name="_GoogleTranslate" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/site-reveal.js" asp-append-version="true"></script>
    @if (isLux)
    {
        <script src="~/js/lux.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
