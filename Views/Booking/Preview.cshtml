@model agancywebProject.Models.DB.Booking
@{
    var hotel = Model.Hotel!;
    ViewData["Title"] = Lang.T(Context, "پیش‌نمایش رزرو", "Booking preview");
}

<div class="page-container">
    <div class="tour-breadcrumb hotel-breadcrumb">
        <a asp-controller="Hotelsshow" asp-action="Index">@Lang.T(Context, "لیست هتل‌ها", "Hotels")</a>
        <span>›</span>
        <a asp-controller="Hotelsshow" asp-action="Details" asp-route-id="@hotel.Hotel_Id">@Lang.Fin(Context, hotel.name)</a>
        <span>›</span>
        @Lang.T(Context, "پیش‌نمایش سفارش", "Order preview")
    </div>

    <div class="section-heading" style="margin-top:1rem;">
        <h2>@Lang.T(Context, "پیش‌نمایش سفارش", "Order preview")</h2>
        <p>@Lang.T(Context, "لطفا قبل از پرداخت، اطلاعات زیر را بررسی کنید", "Please review the details below before paying")</p>
    </div>

    <div class="booking-steps">
        <div class="booking-step is-done">
            <div class="booking-step-circle">✓</div>
            <div class="booking-step-label">@Lang.T(Context, "اطلاعات رزرو", "Booking info")</div>
        </div>
        <div class="booking-step-sep"></div>
        <div class="booking-step is-active">
            <div class="booking-step-circle">@Lang.T(Context, "۲", "2")</div>
            <div class="booking-step-label">@Lang.T(Context, "پیش‌نمایش", "Preview")</div>
        </div>
        <div class="booking-step-sep"></div>
        <div class="booking-step">
            <div class="booking-step-circle">@Lang.T(Context, "۳", "3")</div>
            <div class="booking-step-label">@Lang.T(Context, "پرداخت", "Payment")</div>
        </div>
        <div class="booking-step-sep"></div>
        <div class="booking-step">
            <div class="booking-step-circle">@Lang.T(Context, "۴", "4")</div>
            <div class="booking-step-label">@Lang.T(Context, "نتیجه", "Result")</div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ViewBag.Error as string))
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="table-wrap booking-summary-card mb-3">
        <h3>@Lang.T(Context, "مشخصات هتل", "Hotel details")</h3>
        <dl class="detail-list">
            <dt>@Lang.T(Context, "هتل", "Hotel")</dt>
            <dd>@Lang.Fin(Context, hotel.name) — @Lang.Fin(Context, hotel.city)</dd>
            <dt>@Lang.T(Context, "نام اتاق", "Room name")</dt>
            <dd>@Lang.Fin(Context, hotel.roomName) (@Lang.T(Context, "ظرفیت", "capacity") @hotel.roomCapacity @Lang.T(Context, "نفر", "persons"))</dd>
            <dt>@Lang.T(Context, "وعده غذایی", "Meals")</dt>
            <dd>@Lang.Meal(Context, hotel.meal, hotel.MealDisplay)</dd>
            <dt>@Lang.T(Context, "تاریخ ورود", "Check-in date")</dt>
            <dd>@Lang.Num(Context, Model.CheckIn.ToString("yyyy-MM-dd"))</dd>
            <dt>@Lang.T(Context, "تاریخ خروج", "Check-out date")</dt>
            <dd>@Lang.Num(Context, Model.CheckOut.ToString("yyyy-MM-dd"))</dd>
        </dl>
    </div>

    <div class="table-wrap booking-summary-card mb-3">
        <h3>@Lang.T(Context, "مشخصات شما", "Your details")</h3>
        <dl class="detail-list">
            <dt>@Lang.T(Context, "نام و نام خانوادگی", "Full name")</dt>
            <dd>@Model.FullName</dd>
            <dt>@Lang.T(Context, "شماره موبایل", "Phone number")</dt>
            <dd dir="ltr">@Model.PhoneNumber</dd>
            @if (!string.IsNullOrWhiteSpace(Model.Note))
            {
                <dt>@Lang.T(Context, "توضیحات / درخواست خاص", "Notes / special request")</dt>
                <dd>@Model.Note</dd>
            }
        </dl>
    </div>

    <div class="table-wrap booking-summary-card mb-3">
        <h3>@Lang.T(Context, "مبلغ قابل پرداخت", "Amount due")</h3>
        <dl class="detail-list">
            <dt>@Lang.T(Context, "تعداد شب", "Nights")</dt>
            <dd>@Model.Nights @Lang.T(Context, "شب", "nights")</dd>
            <dt>@Lang.T(Context, "قیمت هر شب", "Price per night")</dt>
            <dd>@((Model.TotalPrice / Math.Max(1, Model.Nights)).ToString("N0")) @Lang.T(Context, "تومان", "Toman")</dd>
            <dt>@Lang.T(Context, "مبلغ کل", "Total amount")</dt>
            <dd><strong class="booking-total">@Model.TotalPrice.ToString("N0") @Lang.T(Context, "تومان", "Toman")</strong></dd>
        </dl>
    </div>

    <div class="table-wrap admin-form-wrap">
        <div class="admin-form-actions">
            <form asp-action="Pay" asp-route-id="@Model.Booking_Id" method="post" class="d-inline">
                <input type="submit" value="@Lang.T(Context, "پرداخت و تایید نهایی", "Pay & confirm")" class="btn btn-brand" />
            </form>
            <form asp-action="Cancel" asp-route-id="@Model.Booking_Id" method="post" class="d-inline">
                <input type="submit" value="@Lang.T(Context, "انصراف", "Cancel")" class="btn btn-outline-secondary" />
            </form>
        </div>
        <p class="form-text-hint mt-2">@Lang.T(Context, "با کلیک روی «پرداخت و تایید نهایی» به درگاه پرداخت بانکی منتقل می‌شوید. تا زمانی که پرداخت را تکمیل نکنید، این بازه تاریخ قطعی نمی‌شود.", "Clicking &quot;Pay &amp; confirm&quot; will take you to the payment gateway. This date range is not confirmed until payment is completed.")</p>
    </div>
</div>
