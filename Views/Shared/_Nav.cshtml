@{
    bool isTranslated = Lang.IsTranslated(Context);
    string currentUrl = Context.Request.Path + Context.Request.QueryString;
}
<header class="site-header">
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">✈</span> @Lang.T(Context, "آژانس هواپیمایی افق", "Ofogh Air Agency")
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="@Lang.T(Context, "نمایش منو", "Show menu")">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">@Lang.T(Context, "صفحه اصلی", "Home")</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Flightsshow" asp-action="Index">@Lang.T(Context, "بلیط هواپیما", "Flights")</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Hotelsshow" asp-action="Index">@Lang.T(Context, "رزرو هتل", "Hotels")</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#faq-section">@Lang.T(Context, "سوالات متداول", "FAQ")</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#site-footer">@Lang.T(Context, "تماس با ما", "Contact Us")</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Index">@Lang.T(Context, "پنل مدیریت", "Admin Panel")</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Login">@Lang.T(Context, "ورود ادمین", "Admin Login")</a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link lang-toggle notranslate" translate="no" asp-controller="Home" asp-action="SetLanguage"
                           asp-route-lang="@(isTranslated ? "fa" : "en")" asp-route-returnUrl="@currentUrl">
                            🌐 @(isTranslated ? "فارسی" : "English")
                        </a>
                    </li>
                </ul>
                <button type="button" class="theme-toggle" aria-label="@Lang.T(Context, "تغییر حالت روشن/تاریک", "Toggle light/dark mode")" title="@Lang.T(Context, "تغییر حالت روشن/تاریک", "Toggle light/dark mode")">
                    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
                    <svg class="icon-moon" viewBox="0 0 24 24" fill="currentColor"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
                </button>
            </div>
        </div>
    </nav>
</header>
